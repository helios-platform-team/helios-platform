{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"{% if values.hasDatabase -%},
  "ConnectionStrings": {
    "DefaultConnection": "Host={DB_HOST};Username={DB_USER};Password={DB_PASSWORD};Database={DB_NAME}"
  }
{% endif -%}
}
