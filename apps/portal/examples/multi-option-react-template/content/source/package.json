{
  "name": "${{ values.repoName | lower }}",
  "private": true,
  "version": "1.0.0",
  {% if values.buildTool == 'vite' -%}
  "type": "module",
  {%- endif %}
  "scripts": {
    {% if values.buildTool == 'vite' -%}
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
    {%- else -%}
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
    {%- endif %}
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
    {%- if values.stateManagement == 'redux' -%},
    "@reduxjs/toolkit": "^2.12.0",
    "react-redux": "^9.3.0"
    {%- elif values.stateManagement == 'zustand' -%},
    "zustand": "^5.0.14"
    {%- endif %}
    {%- if values.dataFetching == 'react-query' -%},
    "@tanstack/react-query": "^5.101.1"
    {%- endif %}
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3"
    {%- if values.buildTool == 'vite' -%},
    "vite": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.3"
    {%- else -%},
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "html-webpack-plugin": "^5.6.7",
    "babel-loader": "^10.1.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "style-loader": "^4.0.0",
    "css-loader": "^7.1.4"
    {%- endif %}
    {%- if values.styling == 'tailwind' -%},
    "tailwindcss": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "postcss": "^8.5.15",
    "autoprefixer": "^10.5.1"
    {%- if values.buildTool == 'webpack' -%},
    "postcss-loader": "^8.2.1"
    {%- endif %}
    {%- endif %}
  }
}
