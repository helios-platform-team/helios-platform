{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@backstage/cli-defaults": "^0.1.2",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "30.0.0",
    "@playwright/test": "^1.60.0",
    "@types/jest": "30.0.0",
    "jest": "30.2.0",
    "jsdom": "26.1.0",
    "node-gyp": "^12.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@protobufjs/inquire@npm:^1.1.1": "patch:@protobufjs/inquire@npm%3A1.1.1#./.yarn/patches/@protobufjs-inquire-npm-1.1.1-1f267bc97f.patch",
    "@protobufjs/inquire@npm:^1.1.0": "patch:@protobufjs/inquire@npm%3A1.1.1#./.yarn/patches/@protobufjs-inquire-npm-1.1.1-1f267bc97f.patch",
    "@mui/material": "^5.16.7",
    "@mui/icons-material": "^5.16.7",
    "@mui/system": "^5.16.7",
    "@mui/utils": "^5.16.7",
    "@mui/styled-engine": "^5.16.7"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.15.0",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "lucide-react": "^1.16.0",
    "react-hot-toast": "2.6.0"
  }
}
